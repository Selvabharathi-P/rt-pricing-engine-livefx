# Live upstream feed. Copy to .env and fill in the credentials shared with
# your registered email address. .env is git-ignored — never commit it.
UPSTREAM_URL=wss://v3-prod.livefxhub.com/ws/algo
API_KEY=YOUR_PUBLIC_KEY
API_SECRET=YOUR_SECRET_KEY

# Bootstrap admin for /admin (created on first start if the email is new).
# Leave ADMIN_PASSWORD empty to have a random one printed once in the logs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Grafana (http://localhost:3000) admin password; dashboards are viewable without login.
GRAFANA_ADMIN_PASSWORD=

# Optional
# LOG_LEVEL=debug
# SYMBOLS=EURUSD,GBPUSD          # defaults to the full 61-symbol list
# MAX_FRAME_BYTES=9984           # every outgoing frame stays below this
# READ_TIMEOUT=30s               # reconnect if upstream is silent this long
